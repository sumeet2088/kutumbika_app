# API Configuration
API_BASE_URL=http://10.0.2.2:8080
API_VERSION=v1
API_TIMEOUT=30

# App Configuration
APP_NAME=Paarisetu
APP_VERSION=1.0.0
BUILD_NUMBER=1

# Locale Configuration
DEFAULT_LOCALE=en-IN
DEFAULT_TIMEZONE=Asia/Kolkata

# OTP Configuration
OTP_LENGTH=6
OTP_RESEND_TIMER=30
MOBILE_NUMBER_LENGTH=10

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_CRASH_REPORTING=false
ENABLE_LOGGING=true

# Storage Configuration
SECURE_STORAGE_ENABLED=true
SHARED_PREFERENCES_ENABLED=true